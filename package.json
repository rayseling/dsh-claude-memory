{
  "name": "dsh-claude-memory",
  "version": "0.5.0",
  "description": "Loads the Claude Code auto-memory index (~/.claude/projects/<slug>/memory/MEMORY.md) of the session's project into every DeepSeek Harness session, the way Claude Code itself loads it: the index at the first step, topic files on demand.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./locate": "./src/locate.js",
    "./client": "./src/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test test/"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/schemastery": "*",
    "@deepseek-ai/dsh-session-projection": ">=0.2.2-alpha.2",
    "@deepseek-ai/dsh-session": ">=0.2.1-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-commands": "*"
  },
  "engines": {
    "node": "^22.19 || >=24"
  }
}
